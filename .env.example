# Copy to .env for local testing (never commit real credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
JWT_SIGNING_KEY=replace-with-32-byte-random-hex-string
BASE_URL=http://localhost:8080
ALLOWED_EMAIL=you@example.com
USE_FIRESTORE=false
FIRESTORE_DATABASE=(default)
USER_TIMEZONE=UTC

# Optional base physiology profile (auto-attached to summaries)
USER_SEX=
USER_HEIGHT_CM=
USER_BIRTH_YEAR=
USER_GOAL_WEIGHT_LBS=

# Optional FreeStyle Libre 3 / 3+ CGM via LibreLinkUp + /cron/sync-glucose
LLU_EMAIL=
LLU_PASSWORD=
LLU_VERSION=4.16.0
CRON_SECRET=
PORT=8080
